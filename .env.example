# ─────────────────────────────────────────────────────────────
# Nivara — environment template. Copy to `.env` and fill in real
# values. NEVER commit the real `.env` (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Supabase (client-safe keys only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Ola Maps (client key — restrict it in the Ola dashboard)
OLA_MAPS_API_KEY=your-ola-maps-api-key
OLA_MAPS_PROJECT_ID=your-ola-maps-project-id

# ─────────────────────────────────────────────────────────────
# DO NOT put these in the app / this file:
#   - Supabase service_role key   (server-side only)
#   - Postgres direct connection string + DB password
#   - Ola Maps client secret       (server-to-server token exchange only)
# Keep those in your password manager / CI secrets, never in the repo.
# ─────────────────────────────────────────────────────────────
