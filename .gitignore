# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file — ignore real secrets, keep the template
.env
.env.*
!.env.example

# Android signing & credentials — never commit keystores or client secret JSON files
*.jks
*.keystore
key.properties
client_secret*.json
android/app/upload-keystore.jks

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# IDEs (IntelliJ / Android Studio / VS Code) — machine-local project files
.idea/
*.iml
.vscode/

# Stray local scratch files
.write_test

# Binary releases and application packages — keep repo lean
*.apk
*.aab
*.ipa
*.ap_
issues/
